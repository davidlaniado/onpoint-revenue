---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FAQ from '../components/FAQ.astro';
import CTASimple from '../components/CTASimple.astro';
const faq = [
  { q: 'What happens in a revenue review?', a: 'We walk your funnel, checkout, payment flow, and retention numbers with you and show where revenue is leaking and what it is worth to fix. Thirty minutes with a founder.' },
  { q: 'Who owns my customers and card data?', a: 'You do. Your customer list, card vault, and membership data stay with your business. OnPoint builds and runs the system around them.' },
  { q: 'How is OnPoint paid?', a: 'Early on: a support fee, media management, traffic margin, or revenue share, depending on the account. As results compound, the mix moves toward revenue share and platform fees. Billing scales with outcomes.' },
  { q: 'Do you replace my team or my vendors?', a: 'We plug into what already works and connect the pieces. Most operators keep their clinical partners and core stack, and hand OnPoint the revenue system around them.' },
  { q: 'Who approves health claims in ads?', a: 'You do. Claims stay in your words. OnPoint reviews creative against your approved claim set before anything runs.' },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base title="For Operators" description="For cash-pay telehealth operators doing $10M to $150M a year: OnPoint runs acquisition, conversion, checkout, payment continuity, and retention as one revenue system." jsonLd={faqLd}>
  <PageHero kicker="For telehealth operators" title="More of every visitor becomes <span class='text-teal-ink'>recurring revenue.</span>" lead="OnPoint rebuilds the revenue chain your traffic pours into. Acquisition, conversion, checkout, payments, and retention, run as one system, with your customers and card vault staying yours." primary={['Book a revenue review', '/contact/?as=brand']} secondary={['How we partner', '#how']} pills={['$10M to $150M operators', 'Subscription and membership', 'Billing scales with outcomes']} />

  <section class="container-x pt-20 md:pt-28">
    <p class="kicker">What you get</p>
    <h2 class="h2 mt-3 max-w-3xl">The whole revenue path, working together.</h2>
    <div class="mt-10 grid md:grid-cols-2 gap-5">
      <div class="panel-mint reveal">
        <h3 class="text-2xl font-extrabold">You keep</h3>
        <ul class="checks mt-6">
          <li>Your customers, your card vault, and your membership data</li>
          <li>Your brand, your clinical partners, and your health claims</li>
          <li>Full visibility into every number, in real time</li>
          <li>The long-term value of every renewal and cross-sell</li>
        </ul>
      </div>
      <div class="panel-navy reveal">
        <h3 class="text-2xl font-extrabold text-white">OnPoint runs</h3>
        <ul class="checks checks-light mt-6">
          <li>Acquisition through affiliates, paid media, and owned audiences</li>
          <li>Funnel, intake, and checkout optimization</li>
          <li>Payment continuity, failed-payment recovery, and rebill lift</li>
          <li>Retention, winback, and member engagement through ZYVO</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="container-x pt-20 md:pt-28">
    <div class="rounded-[28px] bg-paper p-8 md:p-12">
      <p class="kicker">What we measure</p>
      <h2 class="h2 mt-3 max-w-3xl">The levers that decide telehealth profitability.</h2>
      <div class="mt-10 grid grid-cols-2 lg:grid-cols-5 gap-4">
        {['Landing-page conversion', 'Checkout approval', 'First-rebill success', 'Month-2+ retention', 'Lifetime value'].map((t, i) => (
          <div class="rounded-[20px] bg-white border border-line p-5 reveal"><span class="stage-n">0{i + 1}</span><p class="font-bold text-navy mt-2 leading-snug">{t}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section id="how" class="container-x pt-20 md:pt-28 text-center scroll-mt-24">
    <p class="kicker">How we partner</p>
    <h2 class="h2 mt-3">Land through revenue. Expand into infrastructure.</h2>
    <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-5 gap-8 md:gap-6">
      {[
        ['Revenue readiness', 'Find the leaks across acquisition, funnel, checkout, payments, and retention.'],
        ['OnPoint execution', 'Traffic, CRO, checkout, and optimization go live.'],
        ['WowLoop integration', 'Standardized workflows and tracking on every intervention.'],
        ['ZYVO deployment', 'The member engagement and retention layer goes live.'],
        ['Strategic expansion', 'Revenue share, deeper integrations, and strategic partnership.'],
      ].map(([t, d], i) => (
        <div class="reveal"><span class="step-circle">{i + 1}</span><h3 class="mt-4 text-lg font-bold">{t}</h3><p class="mt-2 text-[15px] text-slate leading-relaxed max-w-xs mx-auto">{d}</p></div>
      ))}
    </div>
  </section>

  <section class="container-x pt-20 md:pt-28">
    <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-10">
      <div><h2 class="h2">Questions operators ask first.</h2></div>
      <FAQ items={faq} />
    </div>
  </section>

  <CTASimple secondary={undefined} />
</Base>
