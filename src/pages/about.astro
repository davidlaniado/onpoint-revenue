---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTASimple from '../components/CTASimple.astro';
import { href } from '../lib/site';
const team = [
  ['bruce-cran', 'Bruce Cran', 'Co-Founder & CEO', 'Technology and payments architect with 30+ years across ecommerce, payments, and performance marketing. CEO of WowPay, a PCI Level 1 platform with $1B+ in payment volume, and founder of WowSuite AI, the engine behind WowLoop.'],
  ['jordan-rolband', 'Jordan Rolband', 'Co-Founder', 'Co-founded and scaled DFO Performance into one of the largest privately held affiliate networks, with $5B+ in consumer revenue. Deep expertise in acquisition, affiliate relationships, and attribution.'],
  ['david-laniado', 'David Laniado', 'Chief Growth Officer', 'Leads commercial growth, operator partnerships, and client expansion. Runs media buying and creative on live telehealth accounts every day.'],
];
---
<Base title="About" description="OnPoint is the revenue infrastructure layer for modern telehealth, built by operators behind billions in consumer revenue and payment volume.">
  <PageHero kicker="About OnPoint" title="Operators who built the pieces, <span class='text-teal-ink'>now connected.</span>" lead="Payments, affiliate distribution, performance marketing, and subscription growth. Our founders built each of these at scale. OnPoint puts them into one revenue system for telehealth." narrow />

  <section class="container-x -mt-8 md:-mt-10 relative z-10">
    <div class="stat-band reveal">
      <p class="stat-title">The experience behind OnPoint</p>
      <div class="stat-grid">
        {[['$5B+', 'in consumer revenue at DFO Performance'], ['$1B+', 'in payment volume on WowPay'], ['30+', 'years in ecommerce, payments, and performance'], ['5', 'revenue levers run as one system']].map(([n, l]) => (
          <div><p class="stat-n">{n}</p><p class="stat-l">{l}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-x pt-20 md:pt-28">
    <div class="grid lg:grid-cols-[1fr_1fr] gap-10 items-start">
      <div>
        <p class="kicker">Why we exist</p>
        <h2 class="h2 mt-3">The product is no longer the moat. The patient revenue system is.</h2>
      </div>
      <div class="prose-op">
        <p>Telehealth solved access. Patients can get care from their phone in minutes. The hard part now is the business behind it: acquiring patients profitably, getting them through checkout, keeping payments flowing, and keeping members on plan.</p>
        <p>Most operators stitch that together from an agency, a CRO firm, a payment vendor, and a handful of tools. Each one optimizes its own piece. OnPoint connects the whole path, from the first click through every renewal.</p>
        <p>We run live telehealth campaigns every day across GLP-1, TRT, ED, women’s health, and more. What we build for operators comes from those accounts.</p>
      </div>
    </div>
  </section>

  <section class="container-x pt-20 md:pt-28">
    <p class="kicker text-center">The team</p>
    <h2 class="h2 mt-3 text-center">The founders.</h2>
    <div class="mt-10 grid md:grid-cols-3 gap-5">
      {team.map(([i, n, r, d]) => (
        <div class="team-card reveal">
          <img src={href(`/img/team/${i}.webp`)} alt={`${n}, ${r}`} class="team-photo" width="200" height="200" loading="lazy" />
          <h3 class="text-xl font-extrabold mt-5">{n}</h3>
          <p class="team-role mt-1">{r}</p>
          <p class="mt-3 text-[15px] text-slate leading-relaxed">{d}</p>
        </div>
      ))}
    </div>
  </section>

  <CTASimple />
</Base>
